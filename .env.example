# Copia este archivo como ".env" y pega los valores de tu proyecto de Firebase
# (Configuracion del proyecto > General > Tus apps > Configuracion del SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database: Build > Realtime Database > la URL aparece arriba de los datos
VITE_FIREBASE_DATABASE_URL=
